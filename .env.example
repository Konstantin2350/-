ENVIRONMENT=development
PORT=8787

# Leave empty for local development; set strong random values in production.
API_KEY=
# Optional role and tenant keys: key1:viewer:company-a,key2:operator:company-b
API_KEYS=
JWT_SECRET=
JWT_ISSUER=ai-orchestra
WEBHOOK_SECRET=
# For several tenants: company-a=secret-a,company-b=secret-b
WEBHOOK_SECRETS=

# Blogger campaign. Keep the real phone only in .env, never in Git.
PUBLIC_BASE_URL=http://localhost:8787
BLOGGER_CONTACT_PHONE=
BLOGGER_TELEGRAM_USERNAME=
CAMPAIGN_CONFIG_PATH=config/campaigns.json

# Wazzup API. Keep keys only in the deployment secret store.
WAZZUP_API_BASE_URL=https://api.wazzup24.com
WAZZUP_API_KEY=
WAZZUP_WEBHOOK_TOKEN=
WAZZUP_AUTO_REPLY=false

# Local fallback uses SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./orchestra.db
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Bitrix24 incoming webhook URL, without a method suffix.
BITRIX_WEBHOOK_URL=

# Any OpenAI-compatible endpoint. Empty key enables deterministic local fallback.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-large
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

MEMORY_TTL_SECONDS=86400
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_CHUNK_OVERLAP=120
MAX_UPLOAD_BYTES=20971520
MAX_DOCUMENT_TEXT_CHARS=5000000
MAX_AUDIO_BYTES=104857600
MAX_AGENT_STEPS=8
RATE_LIMIT_PER_MINUTE=300
CORS_ORIGINS=
