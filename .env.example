ENVIRONMENT=development
PORT=8787

# Leave empty for local development; set strong random values in production.
API_KEY=
WEBHOOK_SECRET=

# Local fallback uses SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./orchestra.db
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
INTERNAL_API_URL=http://localhost:8787

# Bitrix24 incoming webhook URL, without a method suffix.
BITRIX_WEBHOOK_URL=

# Any OpenAI-compatible endpoint. Empty key enables deterministic local fallback.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-large

MEMORY_TTL_SECONDS=86400
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_CHUNK_OVERLAP=120
MAX_UPLOAD_BYTES=20971520
MAX_AGENT_STEPS=8
CORS_ORIGINS=
